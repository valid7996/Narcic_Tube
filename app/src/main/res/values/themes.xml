<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme; Compose draws the real UI, this is just the manifest fallback.
         Values differ between night qualifier so Android can pick correctly. -->
    <style name="Theme.NarcicTub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@null</item>
    </style>

    <!-- ShareTrampolineActivity only: fully invisible so it never flashes
         app UI in front of the app the user shared FROM. -->
    <style name="Theme.NarcicTub.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
